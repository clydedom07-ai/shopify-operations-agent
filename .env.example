# Server
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
API_AUTH_TOKEN=local-dev-token
# HTTP API hardening. Per-IP rate limit (in-memory sliding window, single
# process). API_TRUST_PROXY must be true ONLY behind a reverse proxy that
# forwards X-Forwarded-For — keep it false otherwise.
API_RATE_LIMIT_MAX=120
API_RATE_LIMIT_WINDOW_MS=60000
API_TRUST_PROXY=false
# Persistence. SAFE DEFAULT is memory (never writes anywhere implicitly).
# Set PERSISTENCE=postgres (or auto) to use DATABASE_URL against local
# docker compose Postgres or Supabase. .env values override ambient shell vars.
PERSISTENCE=memory            # memory | auto | postgres

# Postgres (local via docker compose, or Supabase later — same DATABASE_URL)
# DATABASE_URL=postgres://agent:agent@localhost:5432/agent

# LLM backend. No ANTHROPIC_API_KEY → the deterministic scripted gateway runs
# (agent loop fully works with zero credentials and no network). With a key,
# the real Claude gateway is used.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# Email intake. OFF by default — a real mailbox integration does not exist yet,
# so nothing polls unless you opt into the mock (which feeds the scripted
# customer + supplier emails through the same event→task pipeline).
EMAIL_INGESTION=off             # off | mock
# EMAIL_POLL_INTERVAL_MS=60000

# n8n callback. OFF by default: after each task completes, the agent POSTs a
# truth-only task_completed payload to an n8n Webhook trigger so the surrounding
# automation graph can continue. `mock` records the payloads without network
# (hermetic dev/tests); `http` delivers them for real and requires the URL.
N8N_CALLBACK=off                 # off | mock | http
# N8N_WEBHOOK_URL=https://n8n.example.com/webhook/<id>

# Slack. OFF by default on both sides. Outbound: the agent posts honest routine
# updates (e.g. a status reply to the channel a customer messaged) to
# SLACK_CHANNEL; `mock` records without network, `http` POSTs to an Incoming
# Webhook URL and requires it. Inbound: polls Slack messages through the same
# event→task pipeline as email; only the mock provider exists today.
SLACK_NOTIFY=off                 # off | mock | http
# SLACK_WEBHOOK_URL=
# SLACK_CHANNEL=#ops
SLACK_INGESTION=off             # off | mock
# SLACK_POLL_INTERVAL_MS=60000

# Generic outbound REST. OFF by default: the agent may reach ONE
# operator-configured base origin — reads via `rest_get` (auto tier), writes
# via `rest_write` (approval tier). `mock` answers from a route table without
# network (hermetic dev/tests); `http` fetches for real and requires the base.
REST_MODE=off                    # off | mock | http
# REST_BASE_URL=https://ops.internal.example.com

# Shopify. CORE backend: defaults to the deterministic mock (zero credentials).
# `http` talks to the store's Admin REST API — requires the store hostname and
# an Admin API access token. SHOPIFY_API_VERSION pins the REST release; the
# default works but operators should pin the current one.
SHOPIFY_MODE=mock                # off | mock | http
# SHOPIFY_STORE=your-store.myshopify.com
# SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxx
# SHOPIFY_API_VERSION=2024-10

# --- Not yet wired (added in later steps) ---
# SMTP_HOST=